LOGGING_LEVEL=INFO

ELASTICSEARCH_URLS=["http://localhost:9200"]
ELASTICSEARCH_INDEX=rag-documents
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=30.0

OLLAMA_URL=http://localhost:11434

VLLM_EMBEDDING_URL=http://localhost:8001
VLLM_RERANK_URL=http://localhost:8002
VLLM_CHAT_URL=http://localhost:8003

EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120.0
# EMBEDDING_MODEL= qwen3-embedding # ollama: batiai/qwen3-embedding:0.6b
EMBEDDING_MODEL= batiai/qwen3-embedding:0.6b

INGESTION_PROCESSOR=unstructured
INGESTION_EXTRACTION_TIMEOUT_SECONDS=120.0
INGESTION_PDF_STRATEGY=fast
INGESTION_MAX_FILE_SIZE_BYTES=10485760
INGESTION_CHUNK_MAX_CHARACTERS=1500
INGESTION_CHUNK_COMBINE_TEXT_UNDER_N_CHARS=256
INGESTION_CHUNK_NEW_AFTER_N_CHARS=1000

RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_NUM_CANDIDATES=100
RETRIEVAL_RANK_CONSTANT=60

CHAT_PROVIDER=ollama
CHAT_MODEL=qwen2.5:1.5b
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=120.0
CHAT_DEFAULT_TOP_K=8

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag-sys
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_SECURE=false

SNOWFLAKE_INSTANCE_ID=0

DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENT_UPLOAD_URL_TTL_SECONDS=900
