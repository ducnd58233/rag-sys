# Local env and tooling
.env
.env.*
!.env.example
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
coverage/
logs/

# Server runtime output (database, artifacts, isolated run dirs)
server/runtime/

# Server logs
server/logs/

# Legacy runtime dirs (safe to delete locally)
server/.valiq/
server/.valiq-*/

# OS / IDE
.idea/
*.code-workspace.user

# Evaluation corpus fixtures (fetched by scripts/evaluation/download_corpus.py;
# not committed, see docs/rag-evaluation/PLAN.md ADR-EV-006) and run output
# (exported locally, see docs/rag-evaluation/SPEC.md D5 revision).
datasets/pdf/*
!datasets/pdf/.gitkeep
datasets/md/*
!datasets/md/.gitkeep
datasets/docx/*
!datasets/docx/.gitkeep
runs/evaluation/*
!runs/evaluation/.gitkeep
