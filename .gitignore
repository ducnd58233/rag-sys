# Local env and tooling
.env
.env.*
!.env.example
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
coverage/
logs/

# Server runtime output (database, artifacts, isolated run dirs)
server/runtime/

# Server logs
server/logs/

# Legacy runtime dirs (safe to delete locally)
server/.valiq/
server/.valiq-*/

# OS / IDE
.idea/
*.code-workspace.user

# Evaluation corpus fixtures (fetched by scripts/evaluation/download_bioasq.py,
# not committed), the golden dataset built from them (~6MB, exceeds the large-file
# hook below - build it locally with `uv run poe eval-build-golden` instead), and
# run output (exported locally per run, not committed).
datasets/bioasq/raw/*
datasets/bioasq/.index-progress.txt
datasets/golden/bioasq-v1.jsonl
runs/evaluation/*
!runs/evaluation/.gitkeep
