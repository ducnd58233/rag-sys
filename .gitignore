# Local env and tooling
.env
.env.*
!.env.example
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
coverage/
logs/

# Server runtime output (database, artifacts, isolated run dirs)
server/runtime/

# Server logs
server/logs/

# Legacy runtime dirs (safe to delete locally)
server/.valiq/
server/.valiq-*/

# OS / IDE
.idea/
*.code-workspace.user

# Evaluation datasets and run output - all reproducible via `uv run poe eval-prepare`.
datasets/*/raw/*
datasets/*/processed/*
datasets/*/.index-progress.jsonl
datasets/manifest.json
runs/evaluation/*
!runs/evaluation/.gitkeep
