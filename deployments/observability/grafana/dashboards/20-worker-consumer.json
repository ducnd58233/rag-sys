{
  "uid": "obs-worker-consumer",
  "title": "20 - Worker / Consumer",
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["rag-sys", "worker", "consumer"],
  "panels": [
    {
      "id": 1, "title": "Step duration heatmap", "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum by (le) (rate(rag_ingestion_step_duration_seconds_bucket[5m]))", "format": "heatmap", "legendFormat": "{{le}}" }]
    },
    {
      "id": 2, "title": "Outcome breakdown", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum by (step, outcome) (rate(rag_ingestion_step_duration_seconds_count[5m]))", "legendFormat": "{{step}} - {{outcome}}" }]
    },
    {
      "id": 3, "title": "Consume outcome rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum by (outcome) (rate(rag_messaging_consume_duration_seconds_count[5m]))", "legendFormat": "{{outcome}}" }]
    },
    {
      "id": 4, "title": "Lag per partition", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "rag_messaging_consumer_lag", "legendFormat": "{{messaging_destination_name}} / p{{partition}}" }]
    },
    {
      "id": 5, "title": "Document size ingested", "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum by (mime_type) (rate(rag_ingestion_document_size_by_sum[5m]))", "legendFormat": "{{mime_type}}" }]
    }
  ]
}
